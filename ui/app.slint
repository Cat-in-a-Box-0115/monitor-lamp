// Detent UI: the tray popup and the full window.
//
// Look (agreed with the owner, "soft tiles"): near-black ground, one monospace face, small spaced-out uppercase
// section labels, 1 px full-bleed lines between sections, flat tiles that are lighter when on. No icons,
// outlined boxes, progress bars or hint text. Colour only where it means something (each light's dot).
// Solid fills only, plus square-cornered gradient strips: the software renderer draws gradients inside
// rounded shapes badly.

import { ScrollView } from "std-widgets.slint";
import "../assets/fonts/JetBrainsMono-Regular.ttf";

export struct FlowItem {
    name: string,
    c1: color, c2: color, c3: color, c4: color, c5: color,
}

export struct Prefs {
    open-at-login: bool,
    start-hidden: bool,
    close-to-tray: bool,
    on-at-login: bool,
    off-at-shutdown: bool,
    sleep-wake: bool,
    lock-unlock: bool,
    backlight-with-main: bool,
    circ-enabled: bool,
    circ-dim: bool,
    wake: string,
    bed: string,
    ip: string,
    token: string,
}

global Theme {
    out property <color> ground: #0e0e0e;
    out property <color> tile: #151514;
    out property <color> tile-on: #1f1e1c;
    out property <color> line: #242321;
    out property <color> track: #2a2927;
    out property <color> ink: #e8e5de;
    out property <color> muted: #6a6762;
    out property <color> fill: #8a877f;
    out property <color> warn: #e5735f;
    out property <string> face: "JetBrains Mono";
}

component Body inherits Text {
    color: Theme.ink;
    font-size: 13px;
    font-family: Theme.face;
    vertical-alignment: center;
}

component Muted inherits Text {
    color: Theme.muted;
    font-size: 12px;
    font-family: Theme.face;
    vertical-alignment: center;
}

// Small spaced-out uppercase section label
component Label inherits Text {
    color: Theme.muted;
    font-size: 10px;
    font-family: Theme.face;
    letter-spacing: 1.2px;
}

// 1 px line across the whole width (the parent's padding is undone by the caller with x/width)
component Line inherits Rectangle {
    height: 1px;
    background: Theme.line;
}

// A word that can be clicked: bright when `active`, muted otherwise
component Word inherits Text {
    in property <bool> active: true;
    callback clicked;
    font-family: Theme.face;
    font-size: 13px;
    color: active ? Theme.ink : Theme.muted;
    vertical-alignment: center;
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Flat tile: name (with the light's dot) over its state; lighter when on
component Tile inherits Rectangle {
    in property <string> name;
    in property <string> state;
    in property <bool> on;
    in property <color> dot: transparent;
    callback clicked;
    callback right-clicked;
    height: 40px;
    border-radius: 4px;
    background: ta.pressed ? Theme.line : on ? Theme.tile-on : Theme.tile;
    VerticalLayout {
        padding-left: 10px;
        alignment: center;
        spacing: 1px;
        HorizontalLayout {
            spacing: 7px;
            alignment: start;
            if root.dot != transparent: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: root.on ? root.dot : Theme.track;
                }
            }
            Text {
                text: root.name;
                font-family: Theme.face;
                font-size: 12px;
                color: root.on ? Theme.ink : Theme.muted;
            }
        }
        Text {
            text: root.state;
            font-family: Theme.face;
            font-size: 10px;
            color: Theme.muted;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.right-clicked();
            }
        }
        clicked => { root.clicked(); }
    }
}

// Thin slider: 2 px track, tick handle, value on the right. `strip` replaces the fill with a colour strip.
component Fader inherits HorizontalLayout {
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <string> text;
    in property <bool> strip;
    in property <color> strip-from: #7a5530;
    in property <color> strip-to: #3b4a66;
    in property <bool> enabled: true;
    callback moved(float);
    callback released(float);
    spacing: 12px;
    opacity: enabled ? 1 : 0.4;
    height: 22px;
    property <float> frac: max(0, min(1, (value - minimum) / (maximum - minimum)));

    track := Rectangle {
        Rectangle {
            y: (parent.height - self.height) / 2;
            height: 2px;
            background: root.strip ? @linear-gradient(90deg, root.strip-from 0%, Theme.track 50%, root.strip-to 100%) : Theme.track;
        }
        if !root.strip: Rectangle {
            x: 0;
            y: (parent.height - self.height) / 2;
            width: root.frac * parent.width;
            height: 2px;
            background: Theme.fill;
        }
        Rectangle {
            x: root.frac * (parent.width - self.width);
            y: (parent.height - self.height) / 2;
            width: 2px;
            height: 12px;
            background: Theme.ink;
        }
        TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            pointer-event(e) => {
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                    root.set-at(self.mouse-x);
                }
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                    root.released(root.value);
                }
            }
            moved => {
                if (self.pressed) { root.set-at(self.mouse-x); }
            }
            scroll-event(e) => {
                if (!root.enabled) { return reject; }
                root.value = max(root.minimum, min(root.maximum, root.value + (e.delta-y > 0 ? root.step : -root.step) * max(1, round((root.maximum - root.minimum) / root.step / 50))));
                root.moved(root.value);
                root.released(root.value);
                accept
            }
        }
    }
    if root.text != "": Text {
        width: 54px;
        text: root.text;
        font-family: Theme.face;
        font-size: 13px;
        color: Theme.ink;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    function set-at(x: length) {
        root.value = root.minimum + round(max(0, min(1, x / track.width)) * (root.maximum - root.minimum) / root.step) * root.step;
        root.moved(root.value);
    }
}

// A settings row: label on the left, "on"/"off" on the right
component Toggle inherits HorizontalLayout {
    in property <string> label;
    in property <bool> checked;
    callback toggled(bool);
    height: 30px;
    spacing: 12px;
    Body { text: root.label; wrap: word-wrap; horizontal-stretch: 1; }
    Word {
        text: root.checked ? "on" : "off";
        active: root.checked;
        horizontal-alignment: right;
        width: 30px;
        clicked => { root.toggled(!root.checked); }
    }
}

// Text field: no box, just a line underneath
component Field inherits VerticalLayout {
    in property <string> label;
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> password;
    callback edited(string);
    callback accepted(string);
    spacing: 4px;
    Muted { text: root.label; font-size: 11px; }
    Rectangle {
        height: 24px;
        if root.text == "" && !input.has-focus: Text {
            x: 0;
            text: root.placeholder;
            font-family: Theme.face;
            font-size: 13px;
            color: Theme.track;
            vertical-alignment: center;
            height: parent.height;
        }
        input := TextInput {
            text <=> root.text;
            font-family: Theme.face;
            font-size: 13px;
            color: Theme.ink;
            vertical-alignment: center;
            input-type: root.password ? InputType.password : InputType.text;
            edited => { root.edited(self.text); }
            accepted => { root.accepted(self.text); }
        }
    }
    Rectangle {
        height: 1px;
        background: input.has-focus ? Theme.fill : Theme.line;
    }
}

component Button inherits Rectangle {
    in property <string> text;
    callback clicked;
    height: 32px;
    width: label.preferred-width + 28px;
    border-radius: 4px;
    background: ta.pressed ? Theme.line : ta.has-hover ? Theme.tile-on : Theme.tile;
    label := Text {
        text: root.text;
        font-family: Theme.face;
        font-size: 12px;
        color: Theme.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Swatch inherits Rectangle {
    in property <color> fill;
    in property <bool> selected;
    callback clicked;
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background: fill;
    Rectangle {
        y: parent.height + 4px;
        height: 1px;
        background: root.selected ? Theme.ink : transparent;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The lamp block shared by the popup and the window: three tiles and two sliders
component LampControls inherits VerticalLayout {
    in property <bool> main-on;
    in property <bool> bg-on;
    in property <bool> auto-on;
    in property <string> bg-state;
    in property <color> desk-dot;
    in property <color> bg-dot;
    in-out property <float> bright;
    in-out property <float> temp;
    callback main-toggled(bool);
    callback bg-toggled(bool);
    callback bg-options();
    callback auto-clicked();
    callback bright-moved(float);
    callback temp-moved(float);
    spacing: 12px;
    HorizontalLayout {
        spacing: 6px;
        Tile {
            name: "desk";
            state: root.main-on ? "on" : "off";
            on: root.main-on;
            dot: root.desk-dot;
            clicked => { root.main-toggled(!root.main-on); }
        }
        Tile {
            name: "back";
            state: root.bg-on ? root.bg-state : "off";
            on: root.bg-on;
            dot: root.bg-dot;
            clicked => { root.bg-toggled(!root.bg-on); }
            right-clicked => { root.bg-options(); }
        }
        Tile {
            name: "auto";
            state: root.auto-on ? "on" : "off";
            on: root.auto-on;
            clicked => { root.auto-clicked(); }
        }
    }
    Fader {
        minimum: 1;
        maximum: 100;
        value <=> root.bright;
        text: round(root.bright) + "%";
        moved(v) => { root.bright-moved(v); }
    }
    Fader {
        minimum: 2700;
        maximum: 6500;
        step: 50;
        strip: true;
        value <=> root.temp;
        text: round(root.temp) + "K";
        moved(v) => { root.temp-moved(v); }
    }
}

// ---------------------------------------------------------------------------------------------------
// The tray popup

export component Popup inherits Window {
    title: "Detent popup";
    no-frame: true;
    always-on-top: true;
    width: 300px;
    height: layout.preferred-height;
    background: Theme.ground;
    default-font-family: Theme.face;

    in property <bool> main-on;
    in property <bool> bg-on;
    in property <bool> auto-on;
    in property <string> bg-state: "on";
    in property <color> desk-dot: #ffd9a8;
    in property <color> bg-dot: #ffb340;
    in-out property <float> bright: 60;
    in-out property <float> temp: 4000;
    in property <bool> has-media;
    in property <bool> playing;
    in property <string> song;
    in property <string> artist;
    in property <image> art;
    in property <bool> has-art;
    in property <string> knob-text: "no knob";

    callback main-toggled(bool);
    callback bg-toggled(bool);
    callback bg-options();
    callback auto-clicked();
    callback bright-moved(float);
    callback temp-moved(float);
    callback media(int); // 0 previous, 1 play/pause, 2 next
    callback open-window();

    layout := VerticalLayout {
        padding: 20px;
        padding-top: 18px;
        padding-bottom: 14px;
        spacing: 0px;

        Label { text: "LAMP"; }
        Rectangle { height: 10px; }
        LampControls {
            main-on: root.main-on;
            bg-on: root.bg-on;
            auto-on: root.auto-on;
            bg-state: root.bg-state;
            desk-dot: root.desk-dot;
            bg-dot: root.bg-dot;
            bright <=> root.bright;
            temp <=> root.temp;
            main-toggled(v) => { root.main-toggled(v); }
            bg-toggled(v) => { root.bg-toggled(v); }
            bg-options => { root.bg-options(); }
            auto-clicked => { root.auto-clicked(); }
            bright-moved(v) => { root.bright-moved(v); }
            temp-moved(v) => { root.temp-moved(v); }
        }

        if root.has-media: VerticalLayout {
            Rectangle { height: 16px; }
            Rectangle { height: 1px; Line { x: -20px; width: parent.width + 40px; } }
            Rectangle { height: 16px; }
            Label { text: "PLAYING"; }
            Rectangle { height: 10px; }
            HorizontalLayout {
                spacing: 12px;
                height: 42px;
                Rectangle {
                    width: 42px;
                    border-radius: 3px;
                    background: Theme.tile-on;
                    clip: true;
                    if root.has-art: Image {
                        source: root.art;
                        width: parent.width;
                        height: parent.height;
                        image-fit: cover;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Body { text: root.song; overflow: elide; }
                    Muted { text: root.artist; overflow: elide; }
                }
                HorizontalLayout {
                    spacing: 14px;
                    alignment: end;
                    Word { text: "|◀"; font-size: 11px; clicked => { root.media(0); } }
                    // Play / pause: the font has no pause glyph, so the bars are drawn
                    Rectangle {
                        width: 16px;
                        if root.playing: Rectangle {
                            x: 4px; y: (parent.height - 10px) / 2; width: 2px; height: 10px; background: Theme.ink;
                        }
                        if root.playing: Rectangle {
                            x: 10px; y: (parent.height - 10px) / 2; width: 2px; height: 10px; background: Theme.ink;
                        }
                        if !root.playing: Text {
                            text: "▶"; font-family: Theme.face; font-size: 11px; color: Theme.ink;
                            width: parent.width; height: parent.height;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea { mouse-cursor: pointer; clicked => { root.media(1); } }
                    }
                    Word { text: "▶|"; font-size: 11px; clicked => { root.media(2); } }
                }
            }
        }

        Rectangle { height: 16px; }
        Rectangle { height: 1px; Line { x: -20px; width: parent.width + 40px; } }
        Rectangle { height: 12px; }
        HorizontalLayout {
            Muted { text: root.knob-text; font-size: 11px; }
            Rectangle { }
            Word {
                text: "open";
                active: false;
                font-size: 11px;
                clicked => { root.open-window(); }
            }
        }
    }
}

// ---------------------------------------------------------------------------------------------------
// The full window

export component AppWindow inherits Window {
    title: "Detent";
    icon: @image-url("../assets/icon.png");
    preferred-width: 380px;
    preferred-height: 640px;
    min-width: 340px;
    min-height: 480px;
    background: Theme.ground;
    default-font-family: Theme.face;

    // 0 = main, 1 = settings
    in-out property <int> view: 0;
    in property <string> version;

    // status
    in property <string> status-text: "Connecting…";
    in property <int> status-kind: 0; // 0 unknown, 1 online, 2 offline

    // main light
    in property <bool> main-on;
    in property <string> main-sub;
    in property <color> main-tint: #ffd9a8;
    in-out property <float> main-bright: 60;
    in-out property <float> main-temp: 4000;
    in property <string> bright-label: "60%";
    in property <bool> auto-active;

    // backlight
    in property <bool> bg-on;
    in property <color> bg-color: #ffb340;
    in property <brush> bg-fill: #ffb340;
    in property <string> bg-sub;
    in property <string> bg-hex: "#FFB340";
    in-out property <float> bg-bright: 100;
    in-out property <float> hue: 36;
    in-out property <int> mode: 0; // 0 solid, 1 flow, 2 screen sync
    in property <[color]> swatches;
    in property <[FlowItem]> flows;
    in property <string> active-flow;
    in-out property <float> flow-speed: 4;
    property <string> custom-hex-text;

    // screen sync
    in property <bool> sync-running;
    in property <color> sync-color: #3a3631;
    in property <string> sync-hex: "not running";
    in property <string> sync-rate;
    in-out property <float> sync-smooth: 3;
    in property <string> sync-smooth-label: "Fast";

    // settings
    in property <Prefs> prefs;
    in-out property <float> wind-down: 180;
    in-out property <float> day-temp: 5000;
    in-out property <float> night-temp: 2700;
    in-out property <float> night-level: 40;
    in property <[color]> curve-colors;
    in property <string> curve-path;
    in property <float> now-frac;
    in property <string> lamp-test;

    // knob
    in property <string> knob-text: "not connected";
    in property <bool> knob-up;
    in-out property <string> provision-result;

    callback retry();
    callback main-toggled(bool);
    callback main-bright-moved(float);
    callback main-temp-moved(float);
    callback auto-clicked();
    callback bg-toggled(bool);
    callback bg-bright-moved(float);
    callback hue-moved(float);
    callback pick-color(color);
    callback custom-hex(string);
    callback mode-selected(int);
    callback flow-picked(string);
    callback sync-clicked();
    callback set-bool(string, bool);
    callback set-number(string, float, bool); // key, value, final (released)
    callback set-text(string, string);
    callback save-lamp(string, string);
    callback open-log();
    callback settings-opened();
    callback provision(string, string); // Wi-Fi name, password

    if root.view == 0: main-scroll := ScrollView {
        VerticalLayout {
            width: main-scroll.visible-width;
            alignment: start;
            padding: 22px;
            padding-top: 16px;
            spacing: 0px;

            // status, and the way to settings
            HorizontalLayout {
                height: 24px;
                spacing: 12px;
                Muted {
                    text: root.status-text;
                    font-size: 11px;
                    color: root.status-kind == 2 ? Theme.warn : Theme.muted;
                    overflow: elide;
                    horizontal-stretch: 1;
                    TouchArea { clicked => { root.retry(); } }
                }
                Word {
                    text: "settings";
                    active: false;
                    font-size: 11px;
                    clicked => {
                        root.view = 1;
                        root.settings-opened();
                    }
                }
            }
            Rectangle { height: 16px; }

            Label { text: "LAMP"; }
            Rectangle { height: 10px; }
            LampControls {
                main-on: root.main-on;
                bg-on: root.bg-on;
                auto-on: root.auto-active;
                bg-state: root.mode == 2 && root.sync-running ? "sync" : root.mode == 1 && root.active-flow != "" ? "flow" : "on";
                desk-dot: root.main-tint;
                bg-dot: root.bg-color;
                bright <=> root.main-bright;
                temp <=> root.main-temp;
                main-toggled(v) => { root.main-toggled(v); }
                bg-toggled(v) => { root.bg-toggled(v); }
                auto-clicked => { root.auto-clicked(); }
                bright-moved(v) => { root.main-bright-moved(v); }
                temp-moved(v) => { root.main-temp-moved(v); }
            }

            Rectangle { height: 18px; }
            Rectangle { height: 1px; Line { x: -22px; width: parent.width + 44px; } }
            Rectangle { height: 18px; }

            // backlight
            HorizontalLayout {
                Label { text: "BACKLIGHT"; vertical-alignment: center; }
                Rectangle { }
                HorizontalLayout {
                    spacing: 16px;
                    Word { text: "colour"; font-size: 12px; active: root.mode == 0; clicked => { root.mode-selected(0); } }
                    Word { text: "flow"; font-size: 12px; active: root.mode == 1; clicked => { root.mode-selected(1); } }
                    Word { text: "screen"; font-size: 12px; active: root.mode == 2; clicked => { root.mode-selected(2); } }
                }
            }
            Rectangle { height: 12px; }
            Fader {
                minimum: 1;
                maximum: 100;
                value <=> root.bg-bright;
                text: round(root.bg-bright) + "%";
                enabled: root.bg-on;
                moved(v) => { root.bg-bright-moved(v); }
            }
            Rectangle { height: 14px; }

            if root.mode == 0: VerticalLayout {
                spacing: 14px;
                HorizontalLayout {
                    alignment: space-between;
                    height: 24px;
                    for c in root.swatches: VerticalLayout {
                        alignment: start;
                        Swatch {
                            fill: c;
                            selected: c == root.bg-color;
                            clicked => { root.pick-color(c); }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    hex := Field {
                        label: "custom colour";
                        text: root.bg-hex;
                        placeholder: "#FFB340";
                        horizontal-stretch: 1;
                        accepted(t) => { root.custom-hex(t); }
                    }
                    VerticalLayout {
                        alignment: end;
                        Button {
                            text: "use";
                            clicked => { root.custom-hex(hex.text); }
                        }
                    }
                }
            }

            if root.mode == 1: VerticalLayout {
                spacing: 4px;
                for f in root.flows: HorizontalLayout {
                    height: 28px;
                    spacing: 14px;
                    property <bool> active: f.name == root.active-flow;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 44px;
                            height: f.name == root.active-flow ? 6px : 3px;
                            background: @linear-gradient(90deg, f.c1 0%, f.c2 25%, f.c3 50%, f.c4 75%, f.c5 100%);
                        }
                    }
                    Word {
                        text: f.name;
                        active: parent.active;
                        horizontal-stretch: 1;
                        clicked => { root.flow-picked(f.name); }
                    }
                }
                Rectangle { height: 8px; }
                HorizontalLayout {
                    spacing: 12px;
                    Muted { text: "speed"; width: 60px; }
                    Fader {
                        minimum: 1;
                        maximum: 10;
                        value <=> root.flow-speed;
                        text: round(root.flow-speed);
                        moved(v) => { root.set-number("flowSpeed", v, false); }
                        released(v) => { root.set-number("flowSpeed", v, true); }
                    }
                }
            }

            if root.mode == 2: VerticalLayout {
                spacing: 14px;
                HorizontalLayout {
                    spacing: 12px;
                    height: 32px;
                    Rectangle {
                        width: 32px;
                        border-radius: 3px;
                        background: root.sync-color;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        horizontal-stretch: 1;
                        Body { text: root.sync-hex; }
                        Muted { text: root.sync-rate; font-size: 11px; overflow: elide; }
                    }
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: root.sync-running ? "stop" : "match screen";
                            clicked => { root.sync-clicked(); }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    Muted { text: "smooth"; width: 60px; }
                    Fader {
                        minimum: 0;
                        maximum: 10;
                        value <=> root.sync-smooth;
                        text: root.sync-smooth-label;
                        moved(v) => { root.set-number("syncSmoothing", v, false); }
                        released(v) => { root.set-number("syncSmoothing", v, true); }
                    }
                }
            }
        }
    }

    if root.view == 1: settings-scroll := ScrollView {
        VerticalLayout {
            width: settings-scroll.visible-width;
            padding: 22px;
            padding-top: 16px;
            spacing: 0px;
            alignment: start;

            HorizontalLayout {
                height: 24px;
                Word {
                    text: "← lamp";
                    active: false;
                    font-size: 11px;
                    clicked => { root.view = 0; }
                }
                Rectangle { }
            }
            Rectangle { height: 16px; }

            // time of day
            Label { text: "TIME OF DAY"; }
            Rectangle { height: 6px; }
            Toggle {
                label: "follow the time of day";
                checked: root.prefs.circ-enabled;
                toggled(v) => { root.set-bool("circadian.enabled", v); }
            }
            Rectangle { height: 8px; }
            VerticalLayout {
                spacing: 4px;
                Rectangle {
                    height: 40px;
                    opacity: root.prefs.circ-enabled ? 1 : 0.35;
                    for c[i] in root.curve-colors: Rectangle {
                        x: i * parent.width / root.curve-colors.length;
                        width: parent.width / root.curve-colors.length + 1px;
                        background: c;
                    }
                    Path {
                        width: 100%;
                        height: 100%;
                        commands: root.curve-path;
                        viewbox-width: 1440;
                        viewbox-height: 100;
                        stroke: #0e0e0ecc;
                        stroke-width: 2px;
                    }
                    Rectangle {
                        x: root.now-frac * parent.width - 1px;
                        width: 2px;
                        background: Theme.ground;
                    }
                }
                HorizontalLayout {
                    alignment: space-between;
                    Muted { text: "0"; font-size: 10px; }
                    Muted { text: "6"; font-size: 10px; }
                    Muted { text: "12"; font-size: 10px; }
                    Muted { text: "18"; font-size: 10px; }
                    Muted { text: "24"; font-size: 10px; }
                }
            }
            Rectangle { height: 12px; }
            HorizontalLayout {
                spacing: 16px;
                Field {
                    label: "wake up";
                    text: root.prefs.wake;
                    placeholder: "07:30";
                    edited(t) => { root.set-text("circadian.wake", t); }
                }
                Field {
                    label: "bedtime";
                    text: root.prefs.bed;
                    placeholder: "23:00";
                    edited(t) => { root.set-text("circadian.bed", t); }
                }
            }
            Rectangle { height: 14px; }
            VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    spacing: 12px;
                    Muted { text: "wind down"; width: 92px; }
                    Fader {
                        minimum: 30;
                        maximum: 240;
                        step: 30;
                        value <=> root.wind-down;
                        text: round(root.wind-down / 6) / 10 + "h";
                        moved(v) => { root.set-number("circadian.windDown", v, false); }
                        released(v) => { root.set-number("circadian.windDown", v, true); }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    Muted { text: "day"; width: 92px; }
                    Fader {
                        minimum: 4000;
                        maximum: 6500;
                        step: 100;
                        value <=> root.day-temp;
                        text: round(root.day-temp) + "K";
                        moved(v) => { root.set-number("circadian.dayTemp", v, false); }
                        released(v) => { root.set-number("circadian.dayTemp", v, true); }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    Muted { text: "bedtime"; width: 92px; }
                    Fader {
                        minimum: 2700;
                        maximum: 4000;
                        step: 100;
                        value <=> root.night-temp;
                        text: round(root.night-temp) + "K";
                        moved(v) => { root.set-number("circadian.nightTemp", v, false); }
                        released(v) => { root.set-number("circadian.nightTemp", v, true); }
                    }
                }
            }
            Rectangle { height: 6px; }
            Toggle {
                label: "dim towards bedtime";
                checked: root.prefs.circ-dim;
                toggled(v) => { root.set-bool("circadian.dim", v); }
            }
            HorizontalLayout {
                spacing: 12px;
                Muted { text: "at bedtime"; width: 92px; }
                Fader {
                    enabled: root.prefs.circ-dim;
                    minimum: 10;
                    maximum: 100;
                    step: 5;
                    value <=> root.night-level;
                    text: round(root.night-level) + "%";
                    moved(v) => { root.set-number("circadian.nightLevel", v, false); }
                    released(v) => { root.set-number("circadian.nightLevel", v, true); }
                }
            }

            Rectangle { height: 18px; }
            Rectangle { height: 1px; Line { x: -22px; width: parent.width + 44px; } }
            Rectangle { height: 18px; }

            Label { text: "WITH THE PC"; }
            Rectangle { height: 6px; }
            Toggle {
                label: "on when I sign in";
                checked: root.prefs.on-at-login;
                toggled(v) => { root.set-bool("onAtLogin", v); }
            }
            Toggle {
                label: "off at shutdown";
                checked: root.prefs.off-at-shutdown;
                toggled(v) => { root.set-bool("offAtShutdown", v); }
            }
            Toggle {
                label: "off at sleep, on at wake";
                checked: root.prefs.sleep-wake;
                toggled(v) => { root.set-bool("sleepWake", v); }
            }
            Toggle {
                label: "off when locked";
                checked: root.prefs.lock-unlock;
                toggled(v) => { root.set-bool("lockUnlock", v); }
            }
            Toggle {
                label: "include the backlight";
                checked: root.prefs.backlight-with-main;
                toggled(v) => { root.set-bool("backlightWithMain", v); }
            }

            Rectangle { height: 18px; }
            Rectangle { height: 1px; Line { x: -22px; width: parent.width + 44px; } }
            Rectangle { height: 18px; }

            Label { text: "KNOB"; }
            Rectangle { height: 8px; }
            Body { text: root.knob-text; color: root.knob-up ? Theme.ink : Theme.muted; }
            Rectangle { height: 12px; }
            HorizontalLayout {
                spacing: 16px;
                ssid := Field { label: "wi-fi name"; }
                pass := Field { label: "password"; password: true; }
            }
            Rectangle { height: 12px; }
            HorizontalLayout {
                spacing: 12px;
                Button {
                    text: "set up knob";
                    clicked => {
                        root.provision(ssid.text, pass.text);
                        pass.text = "";
                    }
                }
                Muted { text: root.provision-result; font-size: 11px; wrap: word-wrap; horizontal-stretch: 1; }
            }
            Rectangle { height: 10px; }
            Muted { text: "cpu temperature needs afterburner's cpu sensor on"; font-size: 11px; wrap: word-wrap; }

            Rectangle { height: 18px; }
            Rectangle { height: 1px; Line { x: -22px; width: parent.width + 44px; } }
            Rectangle { height: 18px; }

            Label { text: "LAMP"; }
            Rectangle { height: 8px; }
            HorizontalLayout {
                spacing: 16px;
                ip := Field { label: "ip address"; text: root.prefs.ip; }
                token := Field { label: "token"; text: root.prefs.token; password: true; }
            }
            Rectangle { height: 12px; }
            HorizontalLayout {
                spacing: 12px;
                Button {
                    text: "save and connect";
                    clicked => { root.save-lamp(ip.text, token.text); }
                }
                Muted { text: root.lamp-test; font-size: 11px; wrap: word-wrap; horizontal-stretch: 1; }
            }

            Rectangle { height: 18px; }
            Rectangle { height: 1px; Line { x: -22px; width: parent.width + 44px; } }
            Rectangle { height: 18px; }

            Label { text: "STARTING UP"; }
            Rectangle { height: 6px; }
            Toggle {
                label: "start with windows";
                checked: root.prefs.open-at-login;
                toggled(v) => { root.set-bool("openAtLogin", v); }
            }
            Toggle {
                label: "start hidden";
                checked: root.prefs.start-hidden;
                toggled(v) => { root.set-bool("startHidden", v); }
            }
            Toggle {
                label: "keep running when closed";
                checked: root.prefs.close-to-tray;
                toggled(v) => { root.set-bool("closeToTray", v); }
            }

            Rectangle { height: 22px; }
            HorizontalLayout {
                Muted { text: "detent " + root.version; font-size: 11px; }
                Rectangle { }
                Word {
                    text: "open log";
                    active: false;
                    font-size: 11px;
                    clicked => { root.open-log(); }
                }
            }
        }
    }
}
